# WindSight Backend Configuration
# Prefix all environment variables with WINDSIGHT_

# PostgreSQL Connection String
WINDSIGHT_DATABASE_URL=postgresql://windsight:windsight@localhost:5432/windsight

# Elexon BMRS API v1 Configuration (no API key required)
WINDSIGHT_ELEXON_BASE_URL=https://data.elexon.co.uk/bmrs/api/v1
WINDSIGHT_ELEXON_TIMEOUT=30
WINDSIGHT_ELEXON_MAX_RETRIES=3

# Allowed CORS Origins (JSON list or comma separated)
WINDSIGHT_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Purchase Decision Cutoff (Hour in Europe/London timezone, default 09:00 AM)
WINDSIGHT_DECISION_CUTOFF_HOUR=9

# Admin API Key for protected endpoints (leave empty to disable check in local dev)
WINDSIGHT_ADMIN_API_KEY=

# Application Log Level (DEBUG, INFO, WARNING, ERROR)
WINDSIGHT_LOG_LEVEL=INFO
